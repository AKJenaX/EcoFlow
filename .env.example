# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_root_password
DB_NAME=ecoflow

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string

# ── Dev flags ─────────────────────────────────────────────────────────────────
# Set to true to allow login with any username + password "devpass" (dev only!)
ALLOW_DEV_AUTH_BYPASS=false
DEV_BYPASS_PASSWORD=devpass

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_IOT=true
ENABLE_OPTIMIZATION=true
ENABLE_COPILOT=true

# ── OpenAI (required for AI Copilot) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Frontend (used by Vite build) ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
RATE_LIMIT_MAX=500
